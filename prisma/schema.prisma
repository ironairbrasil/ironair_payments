// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@map("session")
}

model AsaasShopifyOrder {
  id                       Int       @id @default(autoincrement())
  asaasPaymentId           String    @unique
  asaasCheckoutId          String?   @unique
  asaasCustomerId          String?
  draftOrderId             String?   @unique
  draftOrderName           String?
  shopifyOrderId           String?   @unique
  shopifyOrderName         String?
  externalReference        String
  status                   String    @default("PENDING")
  invoiceUrl               String?
  asaasCheckoutUrl         String?
  failureReason            String?
  attribution              Json?
  checkoutData             Json?
  baseOrderId              Int?      @unique
  baseCustomerId           Int?
  baseSyncStatus           String    @default("PENDING")
  baseSyncError            String?
  baseSyncEvent            String?
  baseSyncedAt             DateTime?
  value                    Float
  couponCode               String?
  discountAmount           Float?
  discountType             String?
  shippingCarrier          String?
  shippingService          String?
  shippingServiceCode      String?
  shippingPrice            Float?
  shippingDeadlineDays     Int?
  shippingDestinationCep   String?
  shippingStatus           String?
  correiosPrePostageId     String?
  correiosReceiptId        String?
  correiosTrackingCode     String?
  correiosStatus           String?
  correiosLabelUrl         String?
  correiosLabelBase64      String?
  correiosRawResponse      Json?
  correiosAttemptedAt      DateTime?
  correiosPrePostedAt      DateTime?
  correiosLabelGeneratedAt DateTime?
  correiosError            String?
  paidAt                   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([externalReference])
}

model AsaasWebhookEvent {
  id             String    @id
  event          String
  asaasPaymentId String?
  payload        Json
  status         String    @default("RECEIVED")
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([asaasPaymentId])
}

model CheckoutAttempt {
  externalReference String   @id
  status            String   @default("PROCESSING")
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
